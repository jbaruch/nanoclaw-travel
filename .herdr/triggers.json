{
  "schema_version": 1,
  "package_roots": [
    "skills/*",
    "rules"
  ],
  "package_change_lines": 400,
  "trust_boundary_paths": [
    ".github/workflows/*",
    "rules/*",
    "skills/*"
  ],
  "cli_spec_paths": [
    "skills/*/scripts/*.py",
    "skills/*/*.py"
  ],
  "cli_surface_markers": [
    "add_parser(",
    "add_argument(",
    "ArgumentParser("
  ],
  "user_doc_paths": [
    "README.md",
    "skills/*/SKILL.md"
  ]
}
